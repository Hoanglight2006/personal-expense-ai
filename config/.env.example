# =============================================================================
# PERSONAL EXPENSE AI — MASTER ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# 1. DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Option A: SQLite (Quick 1-Click test without installing MySQL)
# DATABASE_URL=sqlite:///./personal_expense.db

# Option B: MySQL 8.0 (Production / Standard Environment)
DATABASE_URL=mysql+pymysql://root:<YOUR_MYSQL_PASSWORD>@localhost:3306/personal_expense

# 2. SECURITY & JWT AUTHENTICATION
# -----------------------------------------------------------------------------
SECRET_KEY=<GENERATE_A_RANDOM_SECRET_KEY_MIN_32_CHARS>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_EXPIRE_MINUTES=30

# 3. CORS & FRONTEND DOMAINS
# -----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
FRONTEND_BASE_URL=http://localhost:5173

# 4. EMAIL / SMTP NOTIFICATIONS (OPTIONAL)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<YOUR_EMAIL@gmail.com>
SMTP_PASSWORD=<YOUR_APP_PASSWORD>
SMTP_FROM_EMAIL=<YOUR_EMAIL@gmail.com>

# 5. FILE UPLOAD LIMITS
# -----------------------------------------------------------------------------
MAX_IMAGE_SIZE_MB=10
MAX_EXCEL_SIZE_MB=5

# 6. GOOGLE GEMINI AI SERVICES (OCR & FINAI CHATBOT)
# -----------------------------------------------------------------------------
OCR_PROVIDER=gemini
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_MODEL=gemini-3.5-flash-lite
